# --- Base de datos ---
# Desarrollo local (Docker Compose, ver docker-compose.yml):
DATABASE_URL=postgresql://familyfin:familyfin_dev_password@localhost:5432/familyfin

# Persistencia del servidor: memory o postgres
PERSISTENCE_MODE=memory

# Para apuntar a Neon en vez de local, reemplaza por el connection string real:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Autenticación ---
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TOKEN_EXPIRY=15m

# --- Zonas horarias y límites ---
# Zona para resolver períodos de Reporting y Budgeting (predeterminada: America/Santiago)
# REPORTING_TIMEZONE=America/Santiago
# Límite diario de sugerencias de IA por usuario (predeterminado: 30) y zona del reinicio
# AI_DAILY_LIMIT=30
# AI_USAGE_TIMEZONE=America/Santiago

# --- nivel de log ---
LOG_LEVEL=debug

# --- Swagger UI local ---
ENABLE_LOCAL_SWAGGER=true
