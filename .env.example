# --- Base de datos ---
# Desarrollo local (Docker Compose, ver docker-compose.yml):
DATABASE_URL=postgresql://familyfin:familyfin_dev_password@localhost:5432/familyfin

# Para apuntar a Neon en vez de local, reemplaza por el connection string real:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Autenticación ---
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TOKEN_EXPIRY=15m

# --- nivel de log ---
LOG_LEVEL=debug
