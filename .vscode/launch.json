{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server (dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "src/platform/server.ts"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "Debug Current Test File",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "--test"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}